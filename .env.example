# Copy this file to .env and fill in your real values.
# Never commit your real .env file.

# Personal access token from https://garage61.net/developer/applications
GARAGE61_TOKEN=

# Optional: override the API base URL (rarely needed)
GARAGE61_BASE_URL=https://garage61.net/api/v1

# --- Cloudflare D1 (durable storage for synced lap data) ---
# Only needed for scripts/sync_laps.py, not for app.py itself.
# Database "ohnd-telemetry" already exists in the OHND Cloudflare account.
# See README.md for how to create an API token with D1 edit permissions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=1fd0c977-501d-4fb6-b946-2266a99dceb7
CLOUDFLARE_API_TOKEN=

# --- New-lap notifications (optional) ---
# Webhook URL from a Zap you build in the Zapier web app (Webhooks by
# Zapier "Catch Hook" trigger -> Email by Zapier "Send Outbound Email" to
# pvisracing@gmx.com). See storage/notify.py for step-by-step instructions.
# Leave blank to skip notifications.
ZAPIER_NOTIFY_WEBHOOK_URL=
