# Copy this file to .env and fill in your real values.
# Never commit your real .env file.

# Personal access token from https://garage61.net/developer/applications
GARAGE61_TOKEN=

# Optional: override the API base URL (rarely needed)
GARAGE61_BASE_URL=https://garage61.net/api/v1

# --- Cloudflare D1 (durable storage for synced lap data) ---
# Only needed for scripts/sync_laps.py, not for app.py itself.
# Database "ohnd-telemetry" already exists in the OHND Cloudflare account.
# See README.md for how to create an API token with D1 edit permissions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# --- New-lap notifications (optional) ---
# Free Resend (https://resend.com) API key — sync_laps.py emails
# RESEND_TO_EMAIL when it finds new laps. See storage/notify.py for
# step-by-step setup. Leave blank to skip notifications entirely.
RESEND_API_KEY=

# Address that receives new-lap alerts (e.g. you@example.com).
RESEND_TO_EMAIL=

# Optional: only needed once you verify your own sending domain in Resend.
# Defaults to Resend's shared "onboarding@resend.dev" address otherwise.
RESEND_FROM_EMAIL=
